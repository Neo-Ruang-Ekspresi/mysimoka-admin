# Layanan auth (login/refresh/register) — sama dengan app mobile
VITE_AUTH_BASE_URL=https://auth.mysimoka.sunhouse.co.id
# REST API (saat ini tidak dipakai langsung oleh dashboard, disiapkan untuk integrasi)
VITE_API_BASE_URL=https://api.mysimoka.sunhouse.co.id
# Hasura GraphQL endpoint
VITE_GRAPHQL_URL=https://hasura.mysimoka.sunhouse.co.id/v1/graphql
# Tampilkan menu Superadmin walau JWT belum berisi role super_admin (untuk uji integrasi backend)
VITE_ENABLE_SUPERADMIN_PREVIEW=false
