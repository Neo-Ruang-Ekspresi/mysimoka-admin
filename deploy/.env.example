IMAGE=ghcr.io/neo-ruang-ekspresi/mysimoka-admin
# deploy.sh rewrites this with the commit SHA it deployed.
IMAGE_TAG=main
PROXY_NETWORK=nginx_net
# 1 = build the image on this server instead of pulling it from GHCR
# (use while GitHub Actions is unavailable, e.g. billing lock).
BUILD_LOCAL=0

# Backend URLs baked into the bundle (only with BUILD_LOCAL=1; defaults in Dockerfile).
# After the backend moves to this server:
# VITE_AUTH_BASE_URL=https://auth.mysimoka.id
# VITE_API_BASE_URL=https://api.mysimoka.id
# VITE_GRAPHQL_URL=https://hasura.mysimoka.id/v1/graphql
